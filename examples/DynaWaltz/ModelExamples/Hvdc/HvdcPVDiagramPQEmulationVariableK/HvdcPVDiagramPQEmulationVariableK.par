<!-- Values taken from nrt/data/DynaFlow/HvdcPowerTransfer/HvdcPowerTransfer.par (sets 1, 3, 4, 5, 6, 7 and 8).
     The fixed reactive power limits (Q1MinPu ... Q2MaxPu = +/-100) are replaced by the PQ diagram parameters, flagged
     "DERIVED", which must be reviewed. -->
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="Generator">
    <reference name="generator_P0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="generator_Q0Pu" origData="IIDM" origName="q_pu" type="DOUBLE"/>
    <reference name="generator_U0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <reference name="generator_UPhase0" origData="IIDM" origName="angle_pu" type="DOUBLE"/>
    <reference name="generator_PRef0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="generator_URef0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <par type="DOUBLE" name="generator_PMin" value="-1000000"/>
    <par type="DOUBLE" name="generator_PMax" value="1000000"/>
    <par type="DOUBLE" name="generator_QMin" value="-1000000"/>
    <par type="DOUBLE" name="generator_QMax" value="100000"/>
    <par type="DOUBLE" name="generator_KGover" value="1"/>
    <par type="DOUBLE" name="generator_PNom" value="1"/>
    <par type="DOUBLE" name="generator_QDeadBandPu" value="0.0001"/>
    <par type="DOUBLE" name="generator_UDeadBandPu" value="0.0001"/>
  </set>
  <set id="Load">
    <par type="DOUBLE" name="load_Alpha" value="1.5"/>
    <par type="DOUBLE" name="load_Beta" value="2.5"/>
    <reference type="DOUBLE" name="load_P0Pu" origData="IIDM" origName="p_pu"/>
    <reference type="DOUBLE" name="load_Q0Pu" origData="IIDM" origName="q_pu"/>
    <reference type="DOUBLE" name="load_U0Pu" origData="IIDM" origName="v_pu"/>
    <reference type="DOUBLE" name="load_UPhase0" origData="IIDM" origName="angle_pu"/>
  </set>
  <!-- Parameters shared by both HVDC links -->
  <macroParameterSet id="macro_hvdc">
    <par type="DOUBLE" name="hvdc_Q1Nom" value="400"/>
    <par type="DOUBLE" name="hvdc_Q2Nom" value="400"/>
    <par type="DOUBLE" name="hvdc_Lambda1Pu" value="0"/>
    <par type="DOUBLE" name="hvdc_Lambda2Pu" value="0"/>
    <reference type="DOUBLE" name="hvdc_P20Pu" origData="IIDM" origName="p2_pu"/>
    <reference type="DOUBLE" name="hvdc_Q20Pu" origData="IIDM" origName="q2_pu"/>
    <reference type="DOUBLE" name="hvdc_U20Pu" origData="IIDM" origName="v2_pu"/>
    <reference type="DOUBLE" name="hvdc_UPhase20" origData="IIDM" origName="angle2_pu"/>
    <reference type="DOUBLE" name="hvdc_P10Pu" origData="IIDM" origName="p1_pu"/>
    <reference type="DOUBLE" name="hvdc_P1RefSetPu" origData="IIDM" origName="p1_pu"/>
    <reference type="DOUBLE" name="hvdc_Q10Pu" origData="IIDM" origName="q1_pu"/>
    <reference type="DOUBLE" name="hvdc_U10Pu" origData="IIDM" origName="v1_pu"/>
    <reference type="DOUBLE" name="hvdc_UPhase10" origData="IIDM" origName="angle1_pu"/>
    <reference type="DOUBLE" name="hvdc_PMaxPu" origData="IIDM" origName="pMax_pu"/>
    <par type="DOUBLE" name="hvdc_KLosses" value="1"/>
    <reference name="hvdc_U2Ref0Pu" origData="IIDM" origName="v2_pu" type="DOUBLE"/>
    <reference name="hvdc_Q1Ref0Pu" origData="IIDM" origName="q1_pu" type="DOUBLE"/>
    <reference name="hvdc_Q2Ref0Pu" origData="IIDM" origName="q2_pu" type="DOUBLE"/>
    <!-- DERIVED: PQ diagram built from the reactiveCapabilityCurve of the HVDC converters in the IIDM file (MW/Mvar / 100) -->
    <par type="STRING" name="hvdc_QInj1MinTableFile" value="examples/DynaWaltz/ModelExamples/Hvdc/HvdcPVDiagramPQEmulationVariableK/Diagram.txt"/>
    <par type="STRING" name="hvdc_QInj1MinTableName" value="tableqmin"/>
    <par type="STRING" name="hvdc_QInj2MinTableFile" value="examples/DynaWaltz/ModelExamples/Hvdc/HvdcPVDiagramPQEmulationVariableK/Diagram.txt"/>
    <par type="STRING" name="hvdc_QInj2MinTableName" value="tableqmin"/>
    <par type="STRING" name="hvdc_QInj1MaxTableFile" value="examples/DynaWaltz/ModelExamples/Hvdc/HvdcPVDiagramPQEmulationVariableK/Diagram.txt"/>
    <par type="STRING" name="hvdc_QInj1MaxTableName" value="tableqmax"/>
    <par type="STRING" name="hvdc_QInj2MaxTableFile" value="examples/DynaWaltz/ModelExamples/Hvdc/HvdcPVDiagramPQEmulationVariableK/Diagram.txt"/>
    <par type="STRING" name="hvdc_QInj2MaxTableName" value="tableqmax"/>
    <!-- DERIVED: diagram limits interpolated at the initial active power |p1| = |p2| = 419.25 MW -->
    <par type="DOUBLE" name="hvdc_QInj1Min0Pu" value="-4.7559"/>
    <par type="DOUBLE" name="hvdc_QInj1Max0Pu" value="3.5853"/>
    <par type="DOUBLE" name="hvdc_QInj2Min0Pu" value="-4.7559"/>
    <par type="DOUBLE" name="hvdc_QInj2Max0Pu" value="3.5853"/>
    <par type="DOUBLE" name="acemulation_tFilter" value="50"/>
    <par type="DOUBLE" name="acemulation_KACEmulation0" value="250"/>
    <par type="DOUBLE" name="acemulation_PRefSet0Pu" value="0"/>
  </macroParameterSet>
  <!-- Hvdc1 regulates the voltage on both sides -->
  <set id="Hvdc1">
    <macroParSet id="macro_hvdc"/>
    <par type="BOOL" name="hvdc_modeU10" value="true"/>
    <par type="BOOL" name="hvdc_modeU20" value="true"/>
  </set>
  <!-- Hvdc2 regulates the reactive power on both sides -->
  <set id="Hvdc2">
    <macroParSet id="macro_hvdc"/>
    <par type="BOOL" name="hvdc_modeU10" value="false"/>
    <par type="BOOL" name="hvdc_modeU20" value="false"/>
  </set>
  <set id="PowerTransfer">
    <par type="DOUBLE" name="powertransferhvdcemulation_KACEmulation10" value="250"/>
    <par type="DOUBLE" name="powertransferhvdcemulation_KACEmulation20" value="250"/>
    <par type="DOUBLE" name="powertransferhvdcemulation_PRefSet10Pu" value="0"/>
    <par type="DOUBLE" name="powertransferhvdcemulation_PRefSet20Pu" value="0"/>
  </set>
  <set id="DisconnectHvdc1">
    <par type="DOUBLE" name="event_tEvent" value="30"/>
    <par type="BOOL" name="event_stateEvent1" value="true"/>
  </set>
  <set id="Network">
    <par type="DOUBLE" name="capacitor_no_reclosing_delay" value="300"/>
    <par type="DOUBLE" name="dangling_line_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="line_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="load_Tp" value="90"/>
    <par type="DOUBLE" name="load_Tq" value="90"/>
    <par type="DOUBLE" name="load_alpha" value="1"/>
    <par type="DOUBLE" name="load_alphaLong" value="0"/>
    <par type="DOUBLE" name="load_beta" value="2"/>
    <par type="DOUBLE" name="load_betaLong" value="0"/>
    <par type="BOOL" name="load_isControllable" value="false"/>
    <par type="BOOL" name="load_isRestorative" value="false"/>
    <par type="DOUBLE" name="load_zPMax" value="100"/>
    <par type="DOUBLE" name="load_zQMax" value="100"/>
    <par type="DOUBLE" name="reactance_no_reclosing_delay" value="0"/>
    <par type="DOUBLE" name="transformer_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="transformer_t1st_HT" value="60"/>
    <par type="DOUBLE" name="transformer_t1st_THT" value="30"/>
    <par type="DOUBLE" name="transformer_tNext_HT" value="10"/>
    <par type="DOUBLE" name="transformer_tNext_THT" value="10"/>
    <par type="DOUBLE" name="transformer_tolV" value="0.014999999700000001"/>
  </set>
</parametersSet>
