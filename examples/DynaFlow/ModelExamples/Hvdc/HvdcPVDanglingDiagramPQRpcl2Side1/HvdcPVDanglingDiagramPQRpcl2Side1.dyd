<!-- Derived from nrt/data/DynaFlow/HvdcDangling (terminal 2 of both HVDC links on the switched-off bus _BUS___11_TN):
     the VSC link uses HvdcPVDanglingDiagramPQRpcl2Side1, driven by a simplified secondary voltage control with bus 10
     as pilot point, and a step is applied on its active power reference. The LCC link keeps the HvdcPTanPhiDangling model. -->
<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="Model_Signal_N" lib="SignalN"/>
  <dyn:blackBoxModel id="_Generator___1" staticId="_Generator___1" lib="GeneratorPVSignalN" parFile="HvdcPVDanglingDiagramPQRpcl2Side1.par" parId="Generator">
    <dyn:staticRef var="generator_PGenPu" staticVar="p"/>
    <dyn:staticRef var="generator_QGenPu" staticVar="q"/>
    <dyn:staticRef var="generator_state" staticVar="state"/>
  </dyn:blackBoxModel>
  <dyn:blackBoxModel id="HVDCLCC" lib="HvdcPTanPhiDangling" parFile="HvdcPVDanglingDiagramPQRpcl2Side1.par" parId="HvdcLcc" staticId="HVDCLCCLine">
    <dyn:staticRef var="hvdc_PInj1Pu" staticVar="p1"/>
    <dyn:staticRef var="hvdc_QInj1Pu" staticVar="q1"/>
    <dyn:staticRef var="hvdc_state" staticVar="state1"/>
    <dyn:staticRef var="hvdc_PInj2Pu" staticVar="p2"/>
    <dyn:staticRef var="hvdc_QInj2Pu" staticVar="q2"/>
    <dyn:staticRef var="hvdc_state" staticVar="state2"/>
  </dyn:blackBoxModel>
  <dyn:blackBoxModel id="HVDCVSC" lib="HvdcPVDanglingDiagramPQRpcl2Side1" parFile="HvdcPVDanglingDiagramPQRpcl2Side1.par" parId="HvdcVsc" staticId="HVDCVSCLine">
    <dyn:staticRef var="hvdc_PInj1Pu" staticVar="p1"/>
    <dyn:staticRef var="hvdc_QInj1Pu" staticVar="q1"/>
    <dyn:staticRef var="hvdc_state" staticVar="state1"/>
    <dyn:staticRef var="hvdc_PInj2Pu" staticVar="p2"/>
    <dyn:staticRef var="hvdc_QInj2Pu" staticVar="q2"/>
    <dyn:staticRef var="hvdc_state" staticVar="state2"/>
  </dyn:blackBoxModel>
  <dyn:blackBoxModel id="SVC" lib="SecondaryVoltageControlSimp" parFile="HvdcPVDanglingDiagramPQRpcl2Side1.par" parId="SVC"/>
  <dyn:blackBoxModel id="PRefStep" lib="Step" parFile="HvdcPVDanglingDiagramPQRpcl2Side1.par" parId="PRefStep"/>
  <dyn:connect id1="_Generator___1" var1="generator_terminal" id2="NETWORK" var2="@_Generator___1@@NODE@_ACPIN"/>
  <dyn:connect id1="_Generator___1" var1="generator_switchOffSignal1" id2="NETWORK" var2="@_Generator___1@@NODE@_switchOff"/>
  <dyn:connect id1="_Generator___1" var1="generator_N" id2="Model_Signal_N" var2="signalN_N"/>
  <dyn:connect id1="Model_Signal_N" var1="signalN_thetaRef" id2="NETWORK" var2="_BUS____5_TN_phi"/>
  <dyn:connect id1="NETWORK" var1="_BUS___10_TN_ACPIN" id2="HVDCLCC" var2="hvdc_terminal1"/>
  <dyn:connect id1="NETWORK" var1="_BUS___11_TN_ACPIN" id2="HVDCLCC" var2="hvdc_terminal2"/>
  <dyn:connect id1="NETWORK" var1="_BUS___10_TN_ACPIN" id2="HVDCVSC" var2="hvdc_terminal1"/>
  <dyn:connect id1="NETWORK" var1="_BUS___11_TN_ACPIN" id2="HVDCVSC" var2="hvdc_terminal2"/>
  <dyn:connect id1="SVC" var1="secondaryVoltageControl_UpPu" id2="NETWORK" var2="_BUS___10_TN_Upu"/>
  <dyn:connect id1="SVC" var1="secondaryVoltageControl_limUQUp_1_" id2="HVDCVSC" var2="hvdc_limUQUp1"/>
  <dyn:connect id1="SVC" var1="secondaryVoltageControl_limUQDown_1_" id2="HVDCVSC" var2="hvdc_limUQDown1"/>
  <dyn:connect id1="HVDCVSC" var1="reactivePowerControlLoop_level" id2="SVC" var2="secondaryVoltageControl_level"/>
  <dyn:connect id1="PRefStep" var1="step_step" id2="HVDCVSC" var2="hvdc_P1RefPu"/>
</dyn:dynamicModelsArchitecture>
