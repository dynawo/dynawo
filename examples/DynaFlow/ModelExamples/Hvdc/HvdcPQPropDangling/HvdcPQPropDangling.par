<!-- Values taken from nrt/data/DynaFlow/HvdcDangling (HvdcDangling.par, Network.par, solver.par), except the parameters
     flagged "BORROWED" or "DERIVED", which must be reviewed. -->
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="Solver">
    <par type="DOUBLE" name="fnormtol" value="1e-4"/>
    <par type="DOUBLE" name="fnormtolAlg" value="1e-4"/>
    <par type="DOUBLE" name="fnormtolAlgJ" value="1e-4"/>
    <par type="DOUBLE" name="hMax" value="10"/>
    <par type="DOUBLE" name="hMin" value="1"/>
    <par type="DOUBLE" name="initialaddtol" value="0.1"/>
    <par type="DOUBLE" name="initialaddtolAlg" value="0.1"/>
    <par type="DOUBLE" name="initialaddtolAlgJ" value="0.1"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="INT" name="msbset" value="0"/>
    <par type="INT" name="msbsetAlg" value="1"/>
    <par type="INT" name="msbsetAlgJ" value="1"/>
    <par type="INT" name="mxiter" value="15"/>
    <par type="INT" name="mxiterAlg" value="30"/>
    <par type="INT" name="mxiterAlgJ" value="50"/>
    <par type="DOUBLE" name="mxnewtstep" value="100000"/>
    <par type="DOUBLE" name="mxnewtstepAlg" value="100000"/>
    <par type="DOUBLE" name="mxnewtstepAlgJ" value="100000"/>
    <par type="INT" name="printfl" value="0"/>
    <par type="INT" name="printflAlg" value="0"/>
    <par type="INT" name="printflAlgJ" value="0"/>
    <par type="DOUBLE" name="scsteptol" value="1e-4"/>
    <par type="DOUBLE" name="scsteptolAlg" value="1e-4"/>
    <par type="DOUBLE" name="scsteptolAlgJ" value="1e-4"/>
  </set>
  <set id="Network">
    <par type="DOUBLE" name="capacitor_no_reclosing_delay" value="300"/>
    <par type="DOUBLE" name="dangling_line_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="line_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="load_Tp" value="90"/>
    <par type="DOUBLE" name="load_Tq" value="90"/>
    <par type="DOUBLE" name="load_alpha" value="0"/>
    <par type="DOUBLE" name="load_alphaLong" value="0"/>
    <par type="DOUBLE" name="load_beta" value="0"/>
    <par type="DOUBLE" name="load_betaLong" value="0"/>
    <par type="BOOL" name="load_isControllable" value="false"/>
    <par type="BOOL" name="load_isRestorative" value="false"/>
    <par type="DOUBLE" name="load_zPMax" value="100"/>
    <par type="DOUBLE" name="load_zQMax" value="100"/>
    <par type="DOUBLE" name="reactance_no_reclosing_delay" value="0"/>
    <par type="DOUBLE" name="transformer_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="transformer_t1st_HT" value="60"/>
    <par type="DOUBLE" name="transformer_t1st_THT" value="30"/>
    <par type="DOUBLE" name="transformer_tNext_HT" value="10"/>
    <par type="DOUBLE" name="transformer_tNext_THT" value="10"/>
    <par type="DOUBLE" name="transformer_tolV" value="0.014999999700000001"/>
  </set>
  <set id="Generator">
    <par name="generator_KGover" type="DOUBLE" value="1"/>
    <par name="generator_PMax" type="DOUBLE" value="1.7976931348623157e+308"/>
    <par name="generator_PMin" type="DOUBLE" value="-1.7976931348623157e+308"/>
    <par name="generator_QMax" type="DOUBLE" value="1.7976931348623157e+308"/>
    <par name="generator_QMin" type="DOUBLE" value="-1.7976931348623157e+308"/>
    <reference type="DOUBLE" name="generator_P0Pu" origData="IIDM" origName="p_pu"/>
    <reference type="DOUBLE" name="generator_PRef0Pu" origData="IIDM" origName="p_pu"/>
    <reference type="DOUBLE" name="generator_PNom" origData="IIDM" origName="p_pu"/>
    <reference type="DOUBLE" name="generator_Q0Pu" origData="IIDM" origName="q_pu"/>
    <reference type="DOUBLE" name="generator_U0Pu" origData="IIDM" origName="v_pu"/>
    <reference type="DOUBLE" name="generator_URef0Pu" origData="IIDM" origName="v_pu"/>
    <reference type="DOUBLE" name="generator_UPhase0" origData="IIDM" origName="angle_pu"/>
    <par type="DOUBLE" name="generator_QDeadBandPu" value="0.0001"/>
    <par type="DOUBLE" name="generator_UDeadBandPu" value="0.0001"/>
  </set>
  <!-- HVDC parameters of the nrt case (set "HVDC"), shared by both links -->
  <macroParameterSet id="macro_hvdc">
    <par type="DOUBLE" name="hvdc_Q1Nom" value="400"/>
    <par type="DOUBLE" name="hvdc_Lambda1Pu" value="0"/>
    <reference type="DOUBLE" name="hvdc_P10Pu" origData="IIDM" origName="p1_pu"/>
    <reference type="DOUBLE" name="hvdc_P1RefSetPu" origData="IIDM" origName="p1_pu"/>
    <reference type="DOUBLE" name="hvdc_Q10Pu" origData="IIDM" origName="q1_pu"/>
    <reference type="DOUBLE" name="hvdc_U10Pu" origData="IIDM" origName="v1_pu"/>
    <reference type="DOUBLE" name="hvdc_UPhase10" origData="IIDM" origName="angle1_pu"/>
    <reference type="DOUBLE" name="hvdc_P20Pu" origData="IIDM" origName="p2_pu"/>
    <reference type="DOUBLE" name="hvdc_Q20Pu" origData="IIDM" origName="q2_pu"/>
    <reference type="DOUBLE" name="hvdc_U20Pu" origData="IIDM" origName="v2_pu"/>
    <reference type="DOUBLE" name="hvdc_UPhase20" origData="IIDM" origName="angle2_pu"/>
    <par type="DOUBLE" name="hvdc_Q1MinPu" value="-1.7976931348623157e+308"/>
    <par type="DOUBLE" name="hvdc_Q1MaxPu" value="1.7976931348623157e+308"/>
    <par type="DOUBLE" name="hvdc_KLosses" value="1"/>
    <par type="DOUBLE" name="hvdc_PMaxPu" value="10000"/>
    <par type="BOOL" name="hvdc_modeU10" value="true"/>
    <reference name="hvdc_U2Ref0Pu" origData="IIDM" origName="v2_pu" type="DOUBLE"/>
    <reference name="hvdc_Q1Ref0Pu" origData="IIDM" origName="q1_pu" type="DOUBLE"/>
    <reference name="hvdc_Q2Ref0Pu" origData="IIDM" origName="q2_pu" type="DOUBLE"/>
  </macroParameterSet>
  <!-- LCC link (HvdcPTanPhiDangling, as in the nrt case) -->
  <set id="HvdcLcc">
    <macroParSet id="macro_hvdc"/>
    <reference name="hvdc_CosPhi1Ref0" origData="IIDM" origName="powerFactor" type="DOUBLE" componentId="LCCStation1"/>
    <reference name="hvdc_CosPhi2Ref0" origData="IIDM" origName="powerFactor" type="DOUBLE" componentId="LCCStation1"/>
  </set>
  <!-- VSC link: model under test -->
  <set id="HvdcVsc">
    <macroParSet id="macro_hvdc"/>
    <!-- DERIVED: the link is the only one connected to the remote voltage regulation, so it takes 100 % of the signal -->
    <par type="DOUBLE" name="hvdc_QPercent1" value="1"/>
  </set>
  <!-- BORROWED from nrt/data/DynaFlow/HvdcPQPropDiagramPQ (Gain, tIntegral) -->
  <set id="VRRemote">
    <reference type="DOUBLE" name="vrremote_U0Pu" origData="IIDM" origName="Upu" componentId="_BUS___10_TN"/>
    <reference type="DOUBLE" name="vrremote_URef0Pu" origData="IIDM" origName="Upu" componentId="_BUS___10_TN"/>
    <par type="DOUBLE" name="vrremote_Gain" value="1"/>
    <par type="DOUBLE" name="vrremote_tIntegral" value="0.01"/>
  </set>
  <!-- Scenario added to the nrt case: P1Ref goes from -1 pu (p1 of VSCStation1 in the IIDM file) to -1.5 pu at t = 10 s -->
  <set id="PRefStep">
    <par type="DOUBLE" name="step_Value0" value="-1"/>
    <par type="DOUBLE" name="step_Height" value="-0.5"/>
    <par type="DOUBLE" name="step_tStep" value="10"/>
  </set>
</parametersSet>
