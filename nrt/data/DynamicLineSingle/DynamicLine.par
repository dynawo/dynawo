<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- InfiniteBus -->
  <set id="2">
    <par type="DOUBLE" name="dynline_RPu" value="0.1"/>
    <par type="DOUBLE" name="dynline_LPu" value="1.0"/>
  </set>
  <set id="1">
    <par type="DOUBLE" name="infiniteBus_UPu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="0.0"/>
</set>
  <set id="3">
    <par type="DOUBLE" name="infiniteBus_UPu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="0.1"/>
  </set>
    <set id="7">
    <par type="DOUBLE" name="infiniteBus_UPu" value="0.95"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="-0.05"/>
  </set>

  <set id="IDASolver">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="0.00001"/>
    <!-- Parameters for IDA working-->
    <par type="DOUBLE" name="minStep" value="1e-9"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-09"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="50"/>
    <par type="DOUBLE" name="maxStep" value="10"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
    <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
  </set>

  <set id="SimplifiedSolver">
    <par type="DOUBLE" name="hMin" value="0.0000001"/>
    <par type="DOUBLE" name="hMax" value="0.001"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="50"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
  </set>
</parametersSet>
