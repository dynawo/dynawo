<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
   <dyn:blackBoxModel id="source1" lib="InfiniteBus" parFile="DynamicLine.par" parId="1"/>
   <dyn:blackBoxModel id="dynline" lib="DynLine" parFile="DynamicLine.par" parId="2"/>
   <dyn:blackBoxModel id="source2" lib="InfiniteBus" parFile="DynamicLine.par" parId="3"/>
    <!-- <dyn:blackBoxModel id="line" lib="Line" parFile="DynamicLine.par" parId="8"/> -->

    <dyn:connect id1="source1" var1="infiniteBus_terminal" id2="dynline" var2="dynline_terminal1"/>
    <dyn:connect id1="dynline" var1="dynline_terminal2" id2="source2" var2="infiniteBus_terminal"/>

</dyn:dynamicModelsArchitecture>
