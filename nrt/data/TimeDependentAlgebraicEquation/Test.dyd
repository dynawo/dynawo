<!-- Two infinite buses, a load in the middle; the phase of InfB turns at 0.05 Hz from t = 1 s -->
<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="InfA" lib="InfiniteBusWithVariations" parFile="Test.par" parId="InfA"/>
  <dyn:blackBoxModel id="InfB" lib="InfiniteBusWithVariations" parFile="Test.par" parId="InfB"/>
  <dyn:blackBoxModel id="LineA" lib="Line" parFile="Test.par" parId="Line"/>
  <dyn:blackBoxModel id="LineB" lib="Line" parFile="Test.par" parId="Line"/>
  <dyn:blackBoxModel id="Load" lib="LoadAlphaBeta" parFile="Test.par" parId="Load"/>
  <dyn:connect id1="InfA" var1="infiniteBus_terminal" id2="LineA" var2="line_terminal1"/>
  <dyn:connect id1="LineA" var1="line_terminal2" id2="Load" var2="load_terminal"/>
  <dyn:connect id1="LineB" var1="line_terminal1" id2="Load" var2="load_terminal"/>
  <dyn:connect id1="LineB" var1="line_terminal2" id2="InfB" var2="infiniteBus_terminal"/>
</dyn:dynamicModelsArchitecture>
