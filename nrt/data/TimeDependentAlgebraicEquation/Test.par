<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="InfA">
    <par type="DOUBLE" name="infiniteBus_U0Pu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_UEvtPu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_omega0Pu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_omegaEvtPu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="0"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtStart" value="100"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtEnd" value="100"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtStart" value="100"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtEnd" value="100"/>
  </set>
  <set id="InfB">
    <par type="DOUBLE" name="infiniteBus_U0Pu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_UEvtPu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_omega0Pu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_omegaEvtPu" value="0.999"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="0"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtStart" value="100"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtEnd" value="100"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtStart" value="1"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtEnd" value="100"/>
  </set>
  <set id="Line">
    <par type="DOUBLE" name="line_RPu" value="0"/>
    <par type="DOUBLE" name="line_XPu" value="0.1"/>
    <par type="DOUBLE" name="line_GPu" value="0"/>
    <par type="DOUBLE" name="line_BPu" value="0"/>
  </set>
  <set id="Load">
    <par type="DOUBLE" name="load_alpha" value="1"/>
    <par type="DOUBLE" name="load_beta" value="2"/>
    <par type="DOUBLE" name="load_P0Pu" value="0.1"/>
    <par type="DOUBLE" name="load_Q0Pu" value="0"/>
    <par type="DOUBLE" name="load_U0Pu" value="0.9999874996093545"/>
    <par type="DOUBLE" name="load_UPhase0" value="-0.005000083337083558"/>
  </set>
  <!-- optimizeAlgebraicResidualsEvaluations is left at its default (true) -->
  <set id="TRAP">
    <par type="DOUBLE" name="hMin" value="0.000001"/>
    <par type="DOUBLE" name="hMax" value="0.1"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="0.000001"/>
  </set>
  <set id="SIM">
    <par type="DOUBLE" name="hMin" value="0.000001"/>
    <par type="DOUBLE" name="hMax" value="0.1"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="0.000001"/>
  </set>
</parametersSet>
