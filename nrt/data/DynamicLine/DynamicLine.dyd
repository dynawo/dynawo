<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
   <dyn:blackBoxModel id="source1" lib="InfiniteBus" parFile="DynamicLine.par" parId="5"/>
   <dyn:blackBoxModel id="dynline" lib="DynLine" parFile="DynamicLine.par" parId="1"/>
   <dyn:blackBoxModel id="bus" lib="Bus" parFile="DynamicLine.par" parId="4"/>
   <dyn:blackBoxModel id="line1" lib="Line" parFile="DynamicLine.par" parId="2"/>
   <dyn:blackBoxModel id="source2" lib="InfiniteBus" parFile="DynamicLine.par" parId="6"/>
   <dyn:blackBoxModel id="line2" lib="Line" parFile="DynamicLine.par" parId="3"/>
   <dyn:blackBoxModel id="source3" lib="InfiniteBus" parFile="DynamicLine.par" parId="7"/>
    <!-- <dyn:blackBoxModel id="line3" lib="Line" parFile="DynamicLine.par" parId="8"/> -->

    <dyn:connect id1="source1" var1="infiniteBus_terminal" id2="dynline" var2="dynline_terminal1"/>
    <dyn:connect id1="dynline" var1="dynline_terminal2" id2="bus" var2="bus_terminal"/>
    <!-- <dyn:connect id1="source1" var1="infiniteBus_terminal" id2="line3" var2="line_terminal1"/>
    <dyn:connect id1="line3" var1="line_terminal2" id2="bus" var2="bus_terminal"/> -->
    <dyn:connect id1="bus" var1="bus_terminal" id2="line1" var2="line_terminal1"/>
    <dyn:connect id1="line1" var1="line_terminal2" id2="source2" var2="infiniteBus_terminal"/>
    <dyn:connect id1="bus" var1="bus_terminal" id2="line2" var2="line_terminal1"/>
    <dyn:connect id1="line2" var1="line_terminal2" id2="source3" var2="infiniteBus_terminal"/>

</dyn:dynamicModelsArchitecture>
