<dyn:jobs xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:job name="IEEE14 split - force nodes 1 to 5">
    <dyn:solver lib="dynawo_SolverIDA" parFile="IEEE14.par" parId="solver"/>
    <dyn:modeler compileDir="outputs/compilation">
      <dyn:network iidmFile="IEEE14_split.iidm" parFile="network_force1to5.par" parId="0"/>
      <dyn:dynModels dydFile="IEEE14.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true"/>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="30"/>
    <dyn:outputs directory="outputs_force1to5">
      <dyn:curves inputFile="IEEE14.crv" exportMode="CSV"/>
    </dyn:outputs>
  </dyn:job>
  <dyn:job name="IEEE14 split - force nodes 6 to 14">
    <dyn:solver lib="dynawo_SolverIDA" parFile="IEEE14.par" parId="solver"/>
    <dyn:modeler compileDir="outputs/compilation">
      <dyn:network iidmFile="IEEE14_split.iidm" parFile="network_force6to14.par" parId="0"/>
      <dyn:dynModels dydFile="IEEE14.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true"/>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="30"/>
    <dyn:outputs directory="outputs_force6to14">
      <dyn:curves inputFile="IEEE14.crv" exportMode="CSV"/>
    </dyn:outputs>
  </dyn:job>
</dyn:jobs>
