<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- InfiniteBus -->
  <set id="1">
    <par type="DOUBLE" name="Grid_U0pu" value="1.0"/>
    <par type="DOUBLE" name="Grid_UPhase0" value="0"/>
    <par type="DOUBLE" name="Grid_SNom" value="1000"/>
    <par type="DOUBLE" name="Grid_OmegaRef" value="1.0"/>
    <par type="DOUBLE" name="Grid_RoCoFValue" value="0.01"/>
  </set>

  <set id="2">
    <par type="DOUBLE" name="line_RPu" value="0.000166667"/>
    <par type="DOUBLE" name="line_XPu" value="0.005"/>
    <par type="DOUBLE" name="line_BPu" value="0.0"/>
    <par type="DOUBLE" name="line_GPu" value="0.0"/>
  </set>
  <set id="3">
    <par name="GFMCC_CFilterPu" type="DOUBLE" value="1e-05"/>
    <par name="GFMCC_DeltaIConvMaxPu" type="DOUBLE" value="0.15"/>
    <par name="GFMCC_H" type="DOUBLE" value="3"/>
    <par name="GFMCC_IMaxVI" type="DOUBLE" value="10"/>
    <par name="GFMCC_Imax" type="DOUBLE" value="1.2"/>
    <par name="GFMCC_Imin" type="DOUBLE" value="0"/>
    <par name="GFMCC_Kfd" type="DOUBLE" value="1"/>
    <par name="GFMCC_Kff" type="DOUBLE" value="0.01"/>
    <par name="GFMCC_Kfq" type="DOUBLE" value="0.8"/>
    <par name="GFMCC_Kic" type="DOUBLE" value="15"/>
    <par name="GFMCC_KiPLL" type="DOUBLE" value="10"/>
    <par name="GFMCC_KpPLL" type="DOUBLE" value="100"/>
    <par name="GFMCC_KpVI" type="DOUBLE" value="0.05"/>
    <par name="GFMCC_Kpc" type="DOUBLE" value="2.09"/>
    <par name="GFMCC_LFilterPu" type="DOUBLE" value="0.15"/>
    <par name="GFMCC_LTransformerPu" type="DOUBLE" value="0.06"/>
    <par name="GFMCC_Mq" type="DOUBLE" value="0.2"/>
    <par name="GFMCC_OmegaSetPu" type="DOUBLE" value="1"/>
    <par name="GFMCC_P0Pu" type="DOUBLE" value="-9.9633"/>
    <par name="GFMCC_Q0Pu" type="DOUBLE" value="1.0049"/>
    <par name="GFMCC_RFilterPu" type="DOUBLE" value="0.015"/>
    <par name="GFMCC_RTransformerPu" type="DOUBLE" value="0.006"/>
    <par name="GFMCC_SNom" type="DOUBLE" value="1000"/>
    <par name="GFMCC_U0Pu" type="DOUBLE" value="0.99714"/>
    <par name="GFMCC_UPhase0" type="DOUBLE" value="0.04996"/>
    <par name="GFMCC_W_CurrentLimit" type="DOUBLE" value="50"/>
    <par name="GFMCC_Wf" type="DOUBLE" value="31.4159"/>
    <par name="GFMCC_Wff" type="DOUBLE" value="60"/>
    <par name="GFMCC_XRratio" type="DOUBLE" value="2"/>
    <par name="GFMCC_XVI" type="DOUBLE" value="0"/>
    <par name="GFMCC_kVSM" type="DOUBLE" value="155.955"/>
    <par name="GFMCC_tVSC" type="DOUBLE" value="0.0004"/>
  </set>
  <set id="4">
    <par type="DOUBLE" name="setPoint_Value0" value="1"/>
</set>
<set id="5">
    <par type="DOUBLE" name="setPoint_Value0" value="0"/>
</set>
  <set id="IDASolver">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="0.00001"/>
    <par type="DOUBLE" name="minStep" value="0.000001"/>
    <par type="DOUBLE" name="maxStep" value="10"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
    <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
  </set>

  <set id="SimplifiedSolver">
    <par type="DOUBLE" name="hMin" value="0.000001"/>
    <par type="DOUBLE" name="hMax" value="0.001"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
  </set>
</parametersSet>
