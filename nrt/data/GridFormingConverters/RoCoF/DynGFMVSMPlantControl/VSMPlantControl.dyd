<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
 <dyn:blackBoxModel id="PlantControlVSM"
    lib="DynGridFormingVirtualSynchronousMachinePlantControl"
    parFile="VSMPlantControl.par" parId="1"/>
<dyn:blackBoxModel id="Grid"
    lib="AcGridRoCoF"
    parFile="VSMPlantControl.par" parId="4"/>
<dyn:blackBoxModel id="OmegaRefSrc"
    lib="SetPoint"
    parFile="VSMPlantControl.par" parId="5"/>
<dyn:blackBoxModel id="URefSrc"
    lib="SetPoint"
    parFile="VSMPlantControl.par" parId="6"/>
<dyn:blackBoxModel id="URefGfmSrc"
    lib="SetPoint"
    parFile="VSMPlantControl.par" parId="7"/>
<dyn:blackBoxModel id="PRefSrc"
    lib="SetPoint"
    parFile="VSMPlantControl.par" parId="8"/>
<!--dyn:blackBoxModel id="busInf" lib="InfiniteBus" parFile="VSMPlantControl.par" parId="9"/-->

<!-- Chaîne électrique -->
<dyn:connect id1="PlantControlVSM" var1="Transformer_terminal2" id2="Grid" var2="Grid_aCPower"/>
<!--dyn:connect id1="busInf" var1="infiniteBus_terminal" id2="Measurements" var2="measurements_terminal1"/-->
<!-- Consignes -->
<dyn:connect id1="OmegaRefSrc" var1="setPoint_setPoint" id2="Grid" var2="Grid_OmegaRef"/>
<dyn:connect id1="OmegaRefSrc" var1="setPoint_setPoint" id2="PlantControlVSM" var2="PlantControlVSM_omegaRefPu"/>
<dyn:connect id1="PRefSrc" var1="setPoint_setPoint" id2="PlantControlVSM" var2="PlantControlVSM_PRefPu"/>
<dyn:connect id1="URefSrc" var1="setPoint_setPoint" id2="PlantControlVSM" var2="PlantControlVSM_URefPu"/>
<dyn:connect id1="URefGfmSrc" var1="setPoint_setPoint" id2="PlantControlVSM" var2="PlantControlVSM_UFilterRefPu"/>


</dyn:dynamicModelsArchitecture>
