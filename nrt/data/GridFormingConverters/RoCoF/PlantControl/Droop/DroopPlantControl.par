<parametersSet xmlns="http://www.rte-france.com/dynawo">

  <set id="1">
    <par name="PlantControlDroop_SNom" type="DOUBLE" value="1000"/>
    <par name="PlantControlDroop_U0Pu" type="DOUBLE" value="0.993784186833338"/>
