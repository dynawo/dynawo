    <par name="PlantControlDroop_tUFilt" type="DOUBLE" value="0.1"/>
    <par name="PlantControlDroop_Kpq" type="DOUBLE" value="0.1"/>
    <par name="PlantControlDroop_Kiq" type="DOUBLE" value="1.0"/>
    <par name="PlantControlDroop_Kpp" type="DOUBLE" value="0.3"/>
    <par name="PlantControlDroop_Kip" type="DOUBLE" value="0.3"/>
    <par name="PlantControlDroop_FEMaxPu" type="DOUBLE" value="999"/>
    <par name="PlantControlDroop_FEMinPu" type="DOUBLE" value="-999"/>
