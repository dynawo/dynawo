    <par name="PlantControlDroop_RTransformerPu" type="DOUBLE" value="0.006"/>
    <par name="PlantControlDroop_Wf" type="DOUBLE" value="40"/>
    <par name="PlantControlDroop_Wff" type="DOUBLE" value="50"/>
    <par name="PlantControlDroop_XRratio" type="DOUBLE" value="10"/>
    <par name="PlantControlDroop_XVI" type="DOUBLE" value="0.06"/>
    <par name="PlantControlDroop_tVSC" type="DOUBLE" value="0.0004"/>
    <par name="PlantControlDroop_Mp" type="DOUBLE" value="0.013"/>
    <par name="PlantControlDroop_omegaC" type="DOUBLE" value="1000"/>
    <par name="PlantControlDroop_omegaNPLL" type="DOUBLE" value="100"/>
    <par name="PlantControlDroop_ZetaPLL" type="DOUBLE" value="1"/>
