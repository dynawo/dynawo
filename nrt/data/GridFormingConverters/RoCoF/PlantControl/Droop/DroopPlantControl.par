  <set id="4">
    <par name="Grid_RoCoFValue" type="DOUBLE" value="0.01"/>
    <par name="Grid_SNom" type="DOUBLE" value="1000"/>
    <par name="Grid_StartRoCoF" type="DOUBLE" value="5"/>
    <par name="Grid_TimeRoCoF" type="DOUBLE" value="3"/>
    <par name="Grid_U0pu" type="DOUBLE" value="1"/>
    <par name="Grid_UPhase0" type="DOUBLE" value="0"/>
    <par name="Grid_Upu" type="DOUBLE" value="1"/>
    <par name="Grid_UPhase" type="DOUBLE" value="0"/>
  </set>

  <set id="5">
    <par type="DOUBLE" name="setPoint_Value0" value="1"/>
  </set>

  <set id="6">
    <par type="DOUBLE" name="setPoint_Value0" value="1.0112751027451168"/>
  </set>

  <set id="7">
    <par type="DOUBLE" name="setPoint_Value0" value="0.9980463722094073"/>
  </set>

  <set id="8">
    <par type="DOUBLE" name="setPoint_Value0" value="-9.349410299"/>
  </set>
<set id="IDASolver">
  <par type="INT" name="order" value="2"/>
  <par type="DOUBLE" name="initStep" value="0.00001"/>
  <par type="DOUBLE" name="minStep" value="0.000001"/>
  <par type="DOUBLE" name="maxStep" value="10"/>
  <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
  <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
 <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
</set>

<set id="SimplifiedSolver">
  <par type="DOUBLE" name="hMin" value="0.000001"/>
  <par type="DOUBLE" name="hMax" value="0.0001"/>
  <par type="DOUBLE" name="kReduceStep" value="0.5"/>
  <par type="INT" name="maxNewtonTry" value="10"/>
  <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
</set>

</parametersSet>
