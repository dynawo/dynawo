<curvesInput xmlns="http://www.rte-france.com/dynawo">
  <!-- Measurements at the converter terminal (base SnRef, receptor convention) -->
  <curve model="Meas" variable="measurements_PPu"/>
  <curve model="Meas" variable="measurements_QPu"/>
  <curve model="Meas" variable="measurements_UPu"/>
  <curve model="Meas" variable="measurements_UPhase"/>
  <!-- Angles for DeltaAngle = GFMPvirt_Control_Pvirt_theta - (Grid_UPhase + Grid_theta), with Grid_UPhase = -0.46259718921907295 rad (see VSMPvirt.par) -->
  <curve model="GFMPvirt" variable="GFMPvirt_Control_Pvirt_theta"/>
  <curve model="Grid" variable="Grid_theta"/>
</curvesInput>
