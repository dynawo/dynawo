<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
   <dyn:blackBoxModel id="busInf" lib="InfiniteBusWithVariations_PhaseJump" parFile="SMIB.par" parId="1"/>
  <dyn:blackBoxModel id="line" lib="Line" parFile="SMIB.par" parId="2"/>
  <dyn:blackBoxModel id="GFMDroop" lib="DynGridFormingDroop" parFile="SMIB.par" parId="3"/>
  <dyn:blackBoxModel id="PFilterRef" lib="SetPoint" parFile="SMIB.par" parId="5"/>
  <dyn:blackBoxModel id="QFilterRef" lib="SetPoint" parFile="SMIB.par" parId="6"/>
  <dyn:blackBoxModel id="UFilterRef" lib="SetPoint" parFile="SMIB.par" parId="7"/>
  <dyn:blackBoxModel id="OmegaRef" lib="SetPoint" parFile="SMIB.par" parId="8"/>
  <dyn:connect id1="busInf" var1="infiniteBusPhaseJump_terminal" id2="line" var2="line_terminal1"/>
  <dyn:connect id1="line" var1="line_terminal2" id2="GFMDroop" var2="GFMDroop_terminal"/>
  <dyn:connect id1="PFilterRef" var1="setPoint_setPoint" id2="GFMDroop" var2="GFMDroop_PFilterRefPu"/>
  <dyn:connect id1="QFilterRef" var1="setPoint_setPoint" id2="GFMDroop" var2="GFMDroop_QFilterRefPu"/>
  <dyn:connect id1="UFilterRef" var1="setPoint_setPoint" id2="GFMDroop" var2="GFMDroop_UFilterRefPu"/>
  <dyn:connect id1="OmegaRef" var1="setPoint_setPoint" id2="GFMDroop" var2="GFMDroop_omegaRefPu"/>
</dyn:dynamicModelsArchitecture>
