<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- InfiniteBus -->
  <set id="1">
    <par type="DOUBLE" name="infiniteBusPhaseJump_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_UEvtPu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_UPhase" value="0.0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_omega0Pu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_omegaEvtPu" value="0.0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_tUEvtStart" value="0.0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_tUEvtEnd" value="0.0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_tOmegaEvtStart" value="0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_tOmegaEvtEnd" value="0"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_dUPhaseEvt" value="0.462"/>
    <par type="DOUBLE" name="infiniteBusPhaseJump_tUPhaseEvt" value="10"/>

  </set>
  <!-- line 1 -->
  <set id="2">
    <par type="DOUBLE" name="line_RPu" value="0.005"/>
    <par type="DOUBLE" name="line_XPu" value="0.05"/>
    <par type="DOUBLE" name="line_BPu" value="0.0"/>
    <par type="DOUBLE" name="line_GPu" value="0.0"/>
  </set>
  <set id="3">
    <par name="GFM_CFilterPu" type="DOUBLE" value="1e-05"/>
    <par name="GFM_H" type="DOUBLE" value="5"/>
    <par name="GFM_IMaxVI" type="DOUBLE" value="1.2"/>
    <par name="GFM_Kff" type="DOUBLE" value="0"/>
    <par name="GFM_KpVI" type="DOUBLE" value="0.6"/>
    <par name="GFM_Kfd" type="DOUBLE" value="0.8"/>
    <par name="GFM_Kfq" type="DOUBLE" value="0"/>
    <par name="GFM_LFilterPu" type="DOUBLE" value="0.15"/>
    <par name="GFM_LTransformerPu" type="DOUBLE" value="0.06"/>
    <par name="GFM_Mq" type="DOUBLE" value="0.2"/>
    <par name="GFM_OmegaSetPu" type="DOUBLE" value="1"/>
    <par name="GFM_P0Pu" type="DOUBLE" value="-9.440979955569425"/>
    <par name="GFM_Q0Pu" type="DOUBLE" value="-0.642916511452948"/>
    <par name="GFM_RFilterPu" type="DOUBLE" value="0.015"/>
    <par name="GFM_RTransformerPu" type="DOUBLE" value="0.006"/>
    <par name="GFM_SNom" type="DOUBLE" value="1000"/>
    <par name="GFM_U0Pu" type="DOUBLE" value="0.954110360567147"/>
    <par name="GFM_UPhase0" type="DOUBLE" value="0.513677943263305"/>
    <par name="GFM_Wf" type="DOUBLE" value="31.4159"/>
    <par name="GFM_Wff" type="DOUBLE" value="60"/>
    <par name="GFM_XRratio" type="DOUBLE" value="10"/>
    <par name="GFM_XVI" type="DOUBLE" value="0.06"/>
    <par name="GFM_kVSM" type="DOUBLE" value="650"/>
    <par name="GFM_tVSC" type="DOUBLE" value="0.0004"/>
    <par name="GFM_omegaNPLL" type="DOUBLE" value="100"/>
    <par name="GFM_ZetaPLL" type="DOUBLE" value="1"/>
    <par name="GFM_omegaC" type="DOUBLE" value="1000"/>
  </set>
  <set id="IDASolver">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="0.00001"/>
    <!-- Parameters for IDA working-->
    <par type="DOUBLE" name="minStep" value="1e-9"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-09"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="50"/>
    <par type="DOUBLE" name="maxStep" value="10"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
    <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
    <par type="INT" name="printflAlg" value="2"/>
    <par type="INT" name="printflAlgJ" value="2"/>
    <par type="INT" name="printflAlgInit" value="2"/>
  </set>
  <set id="5">
    <par type="DOUBLE" name="setPoint_Value0" value="0.95"/>
  </set>
  <set id="SimplifiedSolver">
    <par type="DOUBLE" name="hMin" value="0.000001"/>
    <par type="DOUBLE" name="hMax" value="0.001"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
  </set>
  <set id="6">
  <par type="DOUBLE" name="setPoint_Value0" value="0"/>
  </set>
  <set id="7">
    <par type="DOUBLE" name="setPoint_Value0" value="1"/>
  </set>
  <set id="8">
    <par type="DOUBLE" name="setPoint_Value0" value="1"/>
  </set>
</parametersSet>
