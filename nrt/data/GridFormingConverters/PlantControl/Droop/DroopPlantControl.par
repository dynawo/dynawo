<parametersSet xmlns="http://www.rte-france.com/dynawo">
<!-- Same values as Dynawo.Examples.GridForming.PlantControl.DynGFMDroopPlantControlv2 -->
<set id="1">
  <!-- Operating point at the PCC (plant terminal), consistent with the Grid at 1 /_ 0 behind Line1 -->
  <par type="DOUBLE" name="DroopPlantControl_SNom" value="1000"/>
  <par type="DOUBLE" name="DroopPlantControl_UPcc0Pu" value="0.995667946619379"/>
  <par type="DOUBLE" name="DroopPlantControl_UPccPhase0" value="0.0477619859090303"/>
  <par type="DOUBLE" name="DroopPlantControl_PPcc0Pu" value="-9.35033980050001"/>
  <par type="DOUBLE" name="DroopPlantControl_QPcc0Pu" value="1.570601995"/>
  <!-- Plant controller -->
  <par type="DOUBLE" name="DroopPlantControl_Lambd" value="0.01"/>
  <par type="DOUBLE" name="DroopPlantControl_Kdroop" value="0.01"/>
  <par type="DOUBLE" name="DroopPlantControl_tQFilt" value="0.1"/>
  <par type="DOUBLE" name="DroopPlantControl_tPFilt" value="0.1"/>
  <par type="DOUBLE" name="DroopPlantControl_tUFilt" value="0.1"/>
  <par type="DOUBLE" name="DroopPlantControl_Kpq" value="0.1"/>
  <par type="DOUBLE" name="DroopPlantControl_Kiq" value="1.0"/>
  <par type="DOUBLE" name="DroopPlantControl_Kpp" value="0.3"/>
  <par type="DOUBLE" name="DroopPlantControl_Kip" value="0.3"/>
  <par type="DOUBLE" name="DroopPlantControl_QMaxPu" value="100"/>
  <par type="DOUBLE" name="DroopPlantControl_QMinPu" value="-100"/>
  <par type="DOUBLE" name="DroopPlantControl_PMaxPu" value="12"/>
  <par type="DOUBLE" name="DroopPlantControl_PMinPu" value="-12"/>
  <par type="DOUBLE" name="DroopPlantControl_FEMaxPu" value="999"/>
  <par type="DOUBLE" name="DroopPlantControl_FEMinPu" value="-999"/>
  <par type="DOUBLE" name="DroopPlantControl_FDbd1Pu" value="0.005"/>
  <par type="DOUBLE" name="DroopPlantControl_FDbd2Pu" value="0.1"/>
  <par type="DOUBLE" name="DroopPlantControl_DbdPu" value="0.0001"/>
  <!-- GFM: virtual impedance -->
  <par type="DOUBLE" name="DroopPlantControl_KpVI" value="0.1"/>
  <par type="DOUBLE" name="DroopPlantControl_XRratio" value="10"/>
  <par type="DOUBLE" name="DroopPlantControl_IMaxVIPu" value="1.2"/>
  <par  type="DOUBLE" name="DroopPlantControl_EpsVIUpPu" value="0.01"/>
  <par name="DroopPlantControl_EpsVIDownPu" type="DOUBLE" value="0.01"/>
  <!-- GFM: droop & voltage reference control -->
  <par type="DOUBLE" name="DroopPlantControl_Mp" value="0.013"/>
  <par type="DOUBLE" name="DroopPlantControl_Mq" value="0.013"/>
  <par type="DOUBLE" name="DroopPlantControl_Omegaf" value="40"/>
  <par type="DOUBLE" name="DroopPlantControl_Omegaff" value="50"/>
  <par type="DOUBLE" name="DroopPlantControl_Kff" value="0"/>
  <!-- GFM: QSEM -->
  <par type="DOUBLE" name="DroopPlantControl_XVIPu" value="0.06"/>
  <!-- GFM: current loop -->
  <par type="DOUBLE" name="DroopPlantControl_Omegac" value="1000"/>
  <par type="DOUBLE" name="DroopPlantControl_Kfd" value="0.8"/>
  <par type="DOUBLE" name="DroopPlantControl_Kfq" value="0"/>
  <!-- GFM: PLL -->
  <par type="DOUBLE" name="DroopPlantControl_OmegaPLL" value="100"/>
  <par type="DOUBLE" name="DroopPlantControl_KsiPLL" value="1"/>
  <!-- GFM: RLC filter, transformer, VSC -->
  <par type="DOUBLE" name="DroopPlantControl_RFilterPu" value="0.015"/>
  <par type="DOUBLE" name="DroopPlantControl_LFilterPu" value="0.15"/>
  <par type="DOUBLE" name="DroopPlantControl_CFilterPu" value="1e-05"/>
  <par type="DOUBLE" name="DroopPlantControl_RTransformerPu" value="0.006"/>
  <par type="DOUBLE" name="DroopPlantControl_LTransformerPu" value="0.06"/>
  <par type="DOUBLE" name="DroopPlantControl_tVSC" value="0.0004"/>
  <!-- Plant line between GFM and plant transformer -->
  <par type="DOUBLE" name="DroopPlantControl_RPu" value="0.0005"/>
  <par type="DOUBLE" name="DroopPlantControl_XPu" value="0.005"/>
  <par type="DOUBLE" name="DroopPlantControl_GPu" value="0"/>
  <par type="DOUBLE" name="DroopPlantControl_BPu" value="0"/>
  <!-- Plant transformer -->
  <par type="DOUBLE" name="DroopPlantControl_RTfoPu" value="0.0005"/>
  <par type="DOUBLE" name="DroopPlantControl_XTfoPu" value="0.005"/>
  <par type="DOUBLE" name="DroopPlantControl_GTfoPu" value="0"/>
  <par type="DOUBLE" name="DroopPlantControl_BTfoPu" value="0"/>
  <par type="DOUBLE" name="DroopPlantControl_rTfoPu" value="1"/>
</set>
<set id="4">
  <!-- AcGridRoCoF: 1 /_ 0, RoCoF of 0.01 pu/s from t = 5 s during 3 s -->
  <par type="DOUBLE" name="Grid_SNom" value="1000"/>
  <par type="DOUBLE" name="Grid_U0pu" value="1.0"/>
  <par type="DOUBLE" name="Grid_UPhase0" value="0"/>
  <par type="DOUBLE" name="Grid_StartingFrequency" value="0"/>
  <par type="DOUBLE" name="Grid_RoCoFValue" value="0.01"/>
  <par type="DOUBLE" name="Grid_StartRoCoF" value="5"/>
  <par type="DOUBLE" name="Grid_TimeRoCoF" value="3"/>
</set>
<set id="5">
  <!-- OmegaRefSrc -->
  <par type="DOUBLE" name="setPoint_Value0" value="1"/>
</set>
<set id="6">
  <!-- URefSrc = UPcc0Pu + Lambd*QPcc0Pu -->
  <par type="DOUBLE" name="setPoint_Value0" value="1.01137396656938"/>
</set>
<set id="8">
  <!-- PRefSrc = PPcc0Pu -->
  <par type="DOUBLE" name="setPoint_Value0" value="-9.35033980050001"/>
</set>
<set id="10">
  <!-- Line1: between the Grid and the Measurements -->
  <par type="DOUBLE" name="line_RPu" value="0.0005"/>
  <par type="DOUBLE" name="line_XPu" value="0.005"/>
  <par type="DOUBLE" name="line_GPu" value="0"/>
  <par type="DOUBLE" name="line_BPu" value="0"/>
</set>
<set id="11">
  <!-- Measurements: between Line1 and the plant terminal -->
  <par type="DOUBLE" name="measurements_SNom" value="1000"/>
</set>
<set id="IDASolver">
  <par type="INT"    name="order" value="2"/>
  <par type="DOUBLE" name="initStep" value="1e-5"/>
  <par type="DOUBLE" name="minStep" value="1e-8"/>
  <par type="DOUBLE" name="maxStep" value="1e-3"/>
  <par type="DOUBLE" name="absAccuracy" value="1e-6"/>
  <par type="DOUBLE" name="relAccuracy" value="1e-6"/>
  <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
</set>

<set id="SimplifiedSolver">
  <par type="DOUBLE" name="hMin" value="0.000001"/>
  <par type="DOUBLE" name="hMax" value="0.0001"/>
  <par type="DOUBLE" name="kReduceStep" value="0.5"/>
  <par type="INT" name="maxNewtonTry" value="10"/>
  <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
</set>

</parametersSet>
