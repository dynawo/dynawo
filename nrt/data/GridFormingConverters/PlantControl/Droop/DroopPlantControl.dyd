<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
 <dyn:blackBoxModel id="PlantControlDroop"
    lib="DynGridFormingDroopPlantControl"
    parFile="DroopPlantControl.par" parId="1"/>
<dyn:blackBoxModel id="Grid"
    lib="AcGridRoCoF"
    parFile="DroopPlantControl.par" parId="4"/>
<dyn:blackBoxModel id="OmegaRefSrc"
    lib="SetPoint"
    parFile="DroopPlantControl.par" parId="5"/>
<dyn:blackBoxModel id="URefSrc"
    lib="SetPoint"
    parFile="DroopPlantControl.par" parId="6"/>
<dyn:blackBoxModel id="URefGfmSrc"
    lib="SetPoint"
    parFile="DroopPlantControl.par" parId="7"/>
<dyn:blackBoxModel id="PRefSrc"
    lib="SetPoint"
    parFile="DroopPlantControl.par" parId="8"/>
<!-- Chaîne électrique -->
<dyn:connect id1="PlantControlDroop" var1="Transformer_terminal2" id2="Grid" var2="Grid_aCPower"/>
<!-- Consignes -->
<dyn:connect id1="OmegaRefSrc" var1="setPoint_setPoint" id2="Grid" var2="Grid_OmegaRef"/>
<dyn:connect id1="OmegaRefSrc" var1="setPoint_setPoint" id2="PlantControlDroop" var2="PlantControlDroop_omegaRefPu"/>
<dyn:connect id1="PRefSrc" var1="setPoint_setPoint" id2="PlantControlDroop" var2="PlantControlDroop_PRefPu"/>
<dyn:connect id1="URefSrc" var1="setPoint_setPoint" id2="PlantControlDroop" var2="PlantControlDroop_URefPu"/>
<dyn:connect id1="URefGfmSrc" var1="setPoint_setPoint" id2="PlantControlDroop" var2="PlantControlDroop_UFilterRefPu"/>


</dyn:dynamicModelsArchitecture>
