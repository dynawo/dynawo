<parametersSet xmlns="http://www.rte-france.com/dynawo">
<!-- Same values as Dynawo.Examples.GridForming.PlantControl.DynGFMPlantControlv2 -->
<set id="1">
  <!-- Operating point at the PCC (plant terminal) -->
  <par type="DOUBLE" name="VSMPlantControl_SNom" value="1000"/>
  <par type="DOUBLE" name="VSMPlantControl_UPcc0Pu" value="1.02343286532015"/>
  <par type="DOUBLE" name="VSMPlantControl_UPccPhase0" value="0.0464048380960457"/>
  <par type="DOUBLE" name="VSMPlantControl_PPcc0Pu" value="-9.89773532110073"/>
  <par type="DOUBLE" name="VSMPlantControl_QPcc0Pu" value="-4.02696677575302"/>
  <!-- Plant controller -->
  <par type="DOUBLE" name="VSMPlantControl_Lambd" value="0.01"/>
  <par type="DOUBLE" name="VSMPlantControl_Kdroop" value="0"/>
  <par type="DOUBLE" name="VSMPlantControl_tQFilt" value="0.1"/>
  <par type="DOUBLE" name="VSMPlantControl_tPFilt" value="1"/>
  <par type="DOUBLE" name="VSMPlantControl_tUFilt" value="0.1"/>
  <par type="DOUBLE" name="VSMPlantControl_Kpq" value="0.1"/>
  <par type="DOUBLE" name="VSMPlantControl_Kiq" value="1.0"/>
  <par type="DOUBLE" name="VSMPlantControl_Kpp" value="0.3"/>
  <par type="DOUBLE" name="VSMPlantControl_Kip" value="0.3"/>
  <par type="DOUBLE" name="VSMPlantControl_QMaxPu" value="100"/>
  <par type="DOUBLE" name="VSMPlantControl_QMinPu" value="-100"/>
  <par type="DOUBLE" name="VSMPlantControl_PMaxPu" value="100"/>
  <par type="DOUBLE" name="VSMPlantControl_PMinPu" value="-100"/>
  <par type="DOUBLE" name="VSMPlantControl_FEMaxPu" value="999"/>
  <par type="DOUBLE" name="VSMPlantControl_FEMinPu" value="-999"/>
  <par type="DOUBLE" name="VSMPlantControl_FDbd1Pu" value="0.005"/>
  <par type="DOUBLE" name="VSMPlantControl_FDbd2Pu" value="0.1"/>
  <par type="DOUBLE" name="VSMPlantControl_DbdPu" value="0.0001"/>
  <!-- GFM: VSM -->
  <par type="DOUBLE" name="VSMPlantControl_kVSM" value="650"/>
  <par type="DOUBLE" name="VSMPlantControl_H" value="5"/>
  <!-- GFM: virtual impedance -->
  <par type="DOUBLE" name="VSMPlantControl_KpVI" value="0.6"/>
  <par type="DOUBLE" name="VSMPlantControl_XRratio" value="10"/>
  <par type="DOUBLE" name="VSMPlantControl_IMaxVIPu" value="1.2"/>
  <par  type="DOUBLE" name="VSMPlantControl_EpsVIUpPu" value="0.01"/>
  <par name="VSMPlantControl_EpsVIDownPu" type="DOUBLE" value="0.01"/>
  <!-- GFM: voltage reference control -->
  <par type="DOUBLE" name="VSMPlantControl_Mq" value="0.2"/>
  <par type="DOUBLE" name="VSMPlantControl_Omegaf" value="31.4159"/>
  <par type="DOUBLE" name="VSMPlantControl_Omegaff" value="60"/>
  <par type="DOUBLE" name="VSMPlantControl_Kff" value="0"/>
  <!-- GFM: QSEM -->
  <par type="DOUBLE" name="VSMPlantControl_XVIPu" value="0.06"/>
  <!-- GFM: current loop -->
  <par type="DOUBLE" name="VSMPlantControl_Omegac" value="1000"/>
  <par type="DOUBLE" name="VSMPlantControl_Kfd" value="0.8"/>
  <par type="DOUBLE" name="VSMPlantControl_Kfq" value="0"/>
  <!-- GFM: PLL -->
  <par type="DOUBLE" name="VSMPlantControl_OmegaPLL" value="100"/>
  <par type="DOUBLE" name="VSMPlantControl_KsiPLL" value="1"/>
  <!-- GFM: RLC filter, transformer, VSC -->
  <par type="DOUBLE" name="VSMPlantControl_RFilterPu" value="0.015"/>
  <par type="DOUBLE" name="VSMPlantControl_LFilterPu" value="0.15"/>
  <par type="DOUBLE" name="VSMPlantControl_CFilterPu" value="1e-05"/>
  <par type="DOUBLE" name="VSMPlantControl_RTransformerPu" value="0.006"/>
  <par type="DOUBLE" name="VSMPlantControl_LTransformerPu" value="0.06"/>
  <par type="DOUBLE" name="VSMPlantControl_tVSC" value="0.0002"/>
  <!-- Plant line between GFM and plant transformer -->
  <par type="DOUBLE" name="VSMPlantControl_RPu" value="0.0005"/>
  <par type="DOUBLE" name="VSMPlantControl_XPu" value="0.005"/>
  <par type="DOUBLE" name="VSMPlantControl_GPu" value="0"/>
  <par type="DOUBLE" name="VSMPlantControl_BPu" value="0"/>
  <!-- Plant transformer -->
  <par type="DOUBLE" name="VSMPlantControl_RTfoPu" value="0.0005"/>
  <par type="DOUBLE" name="VSMPlantControl_XTfoPu" value="0.005"/>
  <par type="DOUBLE" name="VSMPlantControl_GTfoPu" value="0"/>
  <par type="DOUBLE" name="VSMPlantControl_BTfoPu" value="0"/>
  <par type="DOUBLE" name="VSMPlantControl_rTfoPu" value="1"/>
</set>
<set id="4">
  <!-- AcGridRoCoF -->
  <par type="DOUBLE" name="Grid_SNom" value="1000"/>
  <par type="DOUBLE" name="Grid_U0pu" value="1.0"/>
  <par type="DOUBLE" name="Grid_UPhase0" value="0"/>
  <par type="DOUBLE" name="Grid_StartingFrequency" value="0"/>
  <par type="DOUBLE" name="Grid_RoCoFValue" value="0.01"/>
  <par type="DOUBLE" name="Grid_StartRoCoF" value="5"/>
  <par type="DOUBLE" name="Grid_TimeRoCoF" value="3"/>
</set>
<set id="5">
  <!-- OmegaRefSrc -->
  <par type="DOUBLE" name="setPoint_Value0" value="1"/>
</set>
<set id="6">
  <!-- URefSrc = UPcc0Pu + Lambd*QPcc0Pu -->
  <par type="DOUBLE" name="setPoint_Value0" value="0.983163197562618"/>
</set>
<set id="8">
  <!-- PRefSrc = PPcc0Pu -->
  <par type="DOUBLE" name="setPoint_Value0" value="-9.89773532110073"/>
</set>
<set id="10">
  <!-- Line1 -->
  <par type="DOUBLE" name="line_RPu" value="0.0005"/>
  <par type="DOUBLE" name="line_XPu" value="0.005"/>
  <par type="DOUBLE" name="line_GPu" value="0"/>
  <par type="DOUBLE" name="line_BPu" value="0"/>
</set>
<set id="11">
  <!-- Measurements-->
  <par type="DOUBLE" name="measurements_SNom" value="1000"/>
</set>
<set id="IDASolver">
  <par type="INT"    name="order" value="2"/>
  <par type="DOUBLE" name="initStep" value="1e-5"/>
  <par type="DOUBLE" name="minStep" value="1e-8"/>
  <par type="DOUBLE" name="maxStep" value="1e-3"/>
  <par type="DOUBLE" name="absAccuracy" value="1e-6"/>
  <par type="DOUBLE" name="relAccuracy" value="1e-6"/>
  <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
</set>

<set id="SimplifiedSolver">
  <par type="DOUBLE" name="hMin" value="0.000001"/>
  <par type="DOUBLE" name="hMax" value="0.0001"/>
  <par type="DOUBLE" name="kReduceStep" value="0.5"/>
  <par type="INT" name="maxNewtonTry" value="10"/>
  <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
</set>

</parametersSet>
