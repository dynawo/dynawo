<parametersSet xmlns="http://www.rte-france.com/dynawo">
<!-- Same values as Dynawo.Examples.GridForming.PlantControl.DynGFMCCPlantControlv2 -->
<set id="1">
  <!-- Operating point at the PCC (plant terminal), consistent with the Grid at 1 /_ 0 behind Line1 -->
  <par type="DOUBLE" name="CCVSMPlantControl_SNom" value="1000"/>
  <par type="DOUBLE" name="CCVSMPlantControl_UPcc0Pu" value="1.02343286532015"/>
  <par type="DOUBLE" name="CCVSMPlantControl_UPccPhase0" value="0.0464048380960457"/>
  <par type="DOUBLE" name="CCVSMPlantControl_PPcc0Pu" value="-9.89773532110073"/>
  <par type="DOUBLE" name="CCVSMPlantControl_QPcc0Pu" value="-4.02696677575302"/>
  <!-- Plant controller -->
  <par type="DOUBLE" name="CCVSMPlantControl_Lambd" value="0.01"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kdroop" value="0"/>
  <par type="DOUBLE" name="CCVSMPlantControl_tQFilt" value="0.1"/>
  <par type="DOUBLE" name="CCVSMPlantControl_tPFilt" value="1"/>
  <par type="DOUBLE" name="CCVSMPlantControl_tUFilt" value="0.1"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kpq" value="0.1"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kiq" value="1.0"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kpp" value="0.3"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kip" value="0.3"/>
  <par type="DOUBLE" name="CCVSMPlantControl_QMaxPu" value="100"/>
  <par type="DOUBLE" name="CCVSMPlantControl_QMinPu" value="-100"/>
  <par type="DOUBLE" name="CCVSMPlantControl_PMaxPu" value="100"/>
  <par type="DOUBLE" name="CCVSMPlantControl_PMinPu" value="-100"/>
  <par type="DOUBLE" name="CCVSMPlantControl_FEMaxPu" value="999"/>
  <par type="DOUBLE" name="CCVSMPlantControl_FEMinPu" value="-999"/>
  <par type="DOUBLE" name="CCVSMPlantControl_FDbd1Pu" value="0.005"/>
  <par type="DOUBLE" name="CCVSMPlantControl_FDbd2Pu" value="0.1"/>
  <par type="DOUBLE" name="CCVSMPlantControl_DbdPu" value="0.0001"/>
  <!-- GFM: VSM -->
  <par type="DOUBLE" name="CCVSMPlantControl_kVSM" value="650"/>
  <par type="DOUBLE" name="CCVSMPlantControl_H" value="5"/>
  <par type="DOUBLE" name="CCVSMPlantControl_KDampingAngle" value="0.00318"/>
  <!-- GFM: virtual impedance -->
  <par type="DOUBLE" name="CCVSMPlantControl_KpVI" value="0.6"/>
  <par type="DOUBLE" name="CCVSMPlantControl_XRratio" value="10"/>
  <par type="DOUBLE" name="CCVSMPlantControl_IMaxVIPu" value="1.2"/>
  <par type="DOUBLE" name="CCVSMPlantControl_DeltaIConvMaxPu" value="0.1"/>
  <par  type="DOUBLE" name="CCVSMPlantControl_EpsVIUpPu" value="0.01"/>
  <par name="CCVSMPlantControl_EpsVIDownPu" type="DOUBLE" value="0.01"/>
  <!-- GFM: voltage reference control -->
  <par type="DOUBLE" name="CCVSMPlantControl_Mq" value="0.2"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Omegaf" value="31.4159"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Omegaff" value="60"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kff" value="0"/>
  <!-- GFM: QSEM -->
  <par type="DOUBLE" name="CCVSMPlantControl_XVIPu" value="0.06"/>
  <!-- GFM: current loop -->
  <par type="DOUBLE" name="CCVSMPlantControl_Omegac" value="1000"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kfd" value="0.8"/>
  <par type="DOUBLE" name="CCVSMPlantControl_Kfq" value="0"/>
  <!-- GFM: current saturation -->
  <par type="DOUBLE" name="CCVSMPlantControl_ImaxPu" value="1.2"/>
  <par type="DOUBLE" name="CCVSMPlantControl_IminPu" value="0"/>
  <par  type="DOUBLE" name="CCVSMPlantControl_EpsUpPu" value="0.01"/>
  <par name="CCVSMPlantControl_EpsDownPu" type="DOUBLE" value="0.01"/>
  <par name="CCVSMPlantControl_tSat" type="DOUBLE" value="0.01"/>
  <!-- GFM: PLL -->
  <par type="DOUBLE" name="CCVSMPlantControl_OmegaPLL" value="100"/>
  <par type="DOUBLE" name="CCVSMPlantControl_KsiPLL" value="1"/>
  <!-- GFM: RLC filter, transformer, VSC -->
  <par type="DOUBLE" name="CCVSMPlantControl_RFilterPu" value="0.015"/>
  <par type="DOUBLE" name="CCVSMPlantControl_LFilterPu" value="0.15"/>
  <par type="DOUBLE" name="CCVSMPlantControl_CFilterPu" value="1e-05"/>
  <par type="DOUBLE" name="CCVSMPlantControl_RTransformerPu" value="0.006"/>
  <par type="DOUBLE" name="CCVSMPlantControl_LTransformerPu" value="0.06"/>
  <par type="DOUBLE" name="CCVSMPlantControl_tVSC" value="0.0002"/>
  <!-- Plant line between GFM and plant transformer -->
  <par type="DOUBLE" name="CCVSMPlantControl_RPu" value="0.0005"/>
  <par type="DOUBLE" name="CCVSMPlantControl_XPu" value="0.005"/>
  <par type="DOUBLE" name="CCVSMPlantControl_GPu" value="0"/>
  <par type="DOUBLE" name="CCVSMPlantControl_BPu" value="0"/>
  <!-- Plant transformer -->
  <par type="DOUBLE" name="CCVSMPlantControl_RTfoPu" value="0.0005"/>
  <par type="DOUBLE" name="CCVSMPlantControl_XTfoPu" value="0.005"/>
  <par type="DOUBLE" name="CCVSMPlantControl_GTfoPu" value="0"/>
  <par type="DOUBLE" name="CCVSMPlantControl_BTfoPu" value="0"/>
  <par type="DOUBLE" name="CCVSMPlantControl_rTfoPu" value="1"/>
</set>
<set id="4">
  <!-- AcGridRoCoF: 1 /_ 0, RoCoF of 0.01 pu/s from t = 5 s during 3 s -->
  <par type="DOUBLE" name="Grid_SNom" value="1000"/>
  <par type="DOUBLE" name="Grid_U0pu" value="1.0"/>
  <par type="DOUBLE" name="Grid_UPhase0" value="0"/>
  <par type="DOUBLE" name="Grid_StartingFrequency" value="0"/>
  <par type="DOUBLE" name="Grid_RoCoFValue" value="0.01"/>
  <par type="DOUBLE" name="Grid_StartRoCoF" value="5"/>
  <par type="DOUBLE" name="Grid_TimeRoCoF" value="3"/>
</set>
<set id="5">
  <!-- OmegaRefSrc -->
  <par type="DOUBLE" name="setPoint_Value0" value="1"/>
</set>
<set id="6">
  <!-- URefSrc = UPcc0Pu + Lambd*QPcc0Pu -->
  <par type="DOUBLE" name="setPoint_Value0" value="0.98316319756262"/>
</set>
<set id="8">
  <!-- PRefSrc = PPcc0Pu -->
  <par type="DOUBLE" name="setPoint_Value0" value="-9.89773532110073"/>
</set>
<set id="10">
  <!-- Line1: between the Grid and the Measurements -->
  <par type="DOUBLE" name="line_RPu" value="0.0005"/>
  <par type="DOUBLE" name="line_XPu" value="0.005"/>
  <par type="DOUBLE" name="line_GPu" value="0"/>
  <par type="DOUBLE" name="line_BPu" value="0"/>
</set>
<set id="11">
  <!-- Measurements: between Line1 and the plant terminal -->
  <par type="DOUBLE" name="measurements_SNom" value="1000"/>
</set>
<set id="IDASolver">
  <par type="INT"    name="order" value="2"/>
  <par type="DOUBLE" name="initStep" value="1e-5"/>
  <par type="DOUBLE" name="minStep" value="1e-8"/>
  <par type="DOUBLE" name="maxStep" value="1e-3"/>
  <par type="DOUBLE" name="absAccuracy" value="1e-6"/>
  <par type="DOUBLE" name="relAccuracy" value="1e-6"/>
  <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
</set>
<set id="SimplifiedSolver">
  <par type="DOUBLE" name="hMin" value="0.000001"/>
  <par type="DOUBLE" name="hMax" value="0.0001"/>
  <par type="DOUBLE" name="kReduceStep" value="0.5"/>
  <par type="INT" name="maxNewtonTry" value="10"/>
  <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
</set>
</parametersSet>
