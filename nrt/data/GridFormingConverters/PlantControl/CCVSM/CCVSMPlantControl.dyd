<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
 <dyn:blackBoxModel id="PlantControlCCVSM"
    lib="DynGridFormingCurrentControlledVirtualSynchronousMachinePlantControl"
    parFile="CCVSMPlantControl.par" parId="1"/>
<!-- <dyn:blackBoxModel id="Grid"
    lib="AcGridRoCoF"
    parFile="CCVSMPlantControl.par" parId="4"/> -->
<dyn:blackBoxModel id="busInf" lib="InfiniteBusWithVariations" parFile="CCVSMPlantControl.par" parId="4"/>
<dyn:blackBoxModel id="OmegaRefSrc"
    lib="SetPoint"
    parFile="CCVSMPlantControl.par" parId="5"/>
<dyn:blackBoxModel id="URefSrc"
    lib="SetPoint"
    parFile="CCVSMPlantControl.par" parId="6"/>
<dyn:blackBoxModel id="URefGfmSrc"
    lib="SetPoint"
    parFile="CCVSMPlantControl.par" parId="7"/>
<dyn:blackBoxModel id="PRefSrc"
    lib="SetPoint"
    parFile="CCVSMPlantControl.par" parId="8"/>
<dyn:blackBoxModel id="Line1"
    lib="Line"
    parFile="CCVSMPlantControl.par" parId="10"/>
<dyn:blackBoxModel id="Measurements"
    lib="Measurements"
    parFile="CCVSMPlantControl.par" parId="11"/>
<!--dyn:blackBoxModel id="busInf" lib="InfiniteBus" parFile="CCVSMPlantControl.par" parId="9"/-->

<!-- Chaîne électrique -->
<!-- Grid -> Line1 -> Measurements -> plant transformer (PCC), as in Dynawo.Examples.GridForming.PlantControl.DynGFMCCPlantControl -->
<!-- <dyn:connect id1="Grid" var1="Grid_aCPower" id2="Line1" var2="line_terminal1"/> -->
<dyn:connect id1="busInf" var1="infiniteBus_terminal" id2="Line1" var2="line_terminal1"/>
<dyn:connect id1="Line1" var1="line_terminal2" id2="Measurements" var2="measurements_terminal1"/>
<dyn:connect id1="Measurements" var1="measurements_terminal2" id2="PlantControlCCVSM" var2="Transformer_terminal2"/>

<!-- Consignes -->
<!-- <dyn:connect id1="OmegaRefSrc" var1="setPoint_setPoint" id2="Grid" var2="Grid_OmegaRef"/> -->
<dyn:connect id1="OmegaRefSrc" var1="setPoint_setPoint" id2="PlantControlCCVSM" var2="PlantControlCCVSM_omegaRefPu"/>
<dyn:connect id1="PRefSrc" var1="setPoint_setPoint" id2="PlantControlCCVSM" var2="PlantControlCCVSM_PRefPu"/>
<dyn:connect id1="URefSrc" var1="setPoint_setPoint" id2="PlantControlCCVSM" var2="PlantControlCCVSM_URefPu"/>
<dyn:connect id1="URefGfmSrc" var1="setPoint_setPoint" id2="PlantControlCCVSM" var2="PlantControlCCVSM_UFilterRefPu"/>


</dyn:dynamicModelsArchitecture>
