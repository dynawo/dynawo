    <par type="DOUBLE" name="GFL_KipPlant" value="2.36"/>
    <par type="DOUBLE" name="GFL_KpqPlant" value="0.5"/>
    <par type="DOUBLE" name="GFL_KiqPlant" value="2.36"/>
    <par type="DOUBLE" name="GFL_KpPLL" value="0.31831"/>
