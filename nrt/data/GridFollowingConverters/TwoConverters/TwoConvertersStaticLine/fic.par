<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- Solver -->
  <set id="IDA">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="1e-5"/>
    <par type="DOUBLE" name="minStep" value="1e-8"/>
    <par type="DOUBLE" name="maxStep" value="1e-3"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-5"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-5"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-10"/>
    <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_J_UPDATE"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="100"/>
  </set>
  <set id="IDASolver">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="1e-5"/>
    <par type="DOUBLE" name="minStep" value="1e-10"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-10"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="100"/>
    <par type="DOUBLE" name="maxStep" value="100"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
    <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
  </set>

  <!-- Lines (pu, base SnRef = 100 MVA) -->
  <set id="Line">
    <par type="DOUBLE" name="line_RPu" value="0.00144"/>
    <par type="DOUBLE" name="line_XPu" value="0.0144"/>
    <par type="DOUBLE" name="line_BPu" value="0"/>
    <par type="DOUBLE" name="line_GPu" value="0"/>
  </set>
  <set id="Line2">
    <par type="DOUBLE" name="line_RPu" value="0.02"/>
    <par type="DOUBLE" name="line_XPu" value="0.2"/>
    <par type="DOUBLE" name="line_BPu" value="0"/>
    <par type="DOUBLE" name="line_GPu" value="0"/>
  </set>
  <set id="Line3">
    <par type="DOUBLE" name="line_RPu" value="0.0077775"/>
    <par type="DOUBLE" name="line_XPu" value="0.077775"/>
    <par type="DOUBLE" name="line_BPu" value="0"/>
    <par type="DOUBLE" name="line_GPu" value="0"/>
  </set>

  <!-- Infinite bus: dip to 0.5 pu at t = 15.1 s (zero duration, as in OpenModelica) -->
  <set id="INF">
    <par type="DOUBLE" name="infiniteBus_U0Pu" value="1.1"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="-0.001082"/>
    <par type="DOUBLE" name="infiniteBus_omega0Pu" value="1"/>
    <par type="DOUBLE" name="infiniteBus_UEvtPu" value="0.5"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtStart" value="15.1"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtEnd" value="15.1"/>
    <par type="DOUBLE" name="infiniteBus_omegaEvtPu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtStart" value="1e6"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtEnd" value="1e6"/>
  </set>

  <!-- Converter 1 (gFLmodel) -->
  <!-- Gains from bandwidths: OmegaCC = 1200, OmegaOuter = 10, OmegaPlant = 2, OmegaPLL = 100, KsiPLL = 1, OmegaLPF = 300 rad/s -->
  <set id="GFL1">
    <!-- Initial operating point at PCC (receptor convention, base SnRef) -->
    <par type="DOUBLE" name="GFL_P0Pu" value="-5.010676"/>
    <par type="DOUBLE" name="GFL_Q0Pu" value="-0.21"/>
    <par type="DOUBLE" name="GFL_U0Pu" value="1.091230"/>
    <par type="DOUBLE" name="GFL_UPhase0" value="0.063246"/>
    <par type="DOUBLE" name="GFL_SNom" value="1000"/>
    <!-- VSC, filter, transformer -->
    <par type="DOUBLE" name="GFL_tVSC" value="1e-5"/>
    <par type="DOUBLE" name="GFL_RFilterPu" value="0.003"/>
    <par type="DOUBLE" name="GFL_LFilterPu" value="0.1"/>
    <par type="DOUBLE" name="GFL_CFilterPu" value="1e-5"/>
    <par type="DOUBLE" name="GFL_RTransformerLVPu" value="0.001"/>
    <par type="DOUBLE" name="GFL_LTransformerLVPu" value="0.025"/>
    <par type="DOUBLE" name="GFL_RTransformerHVPu" value="0.001"/>
    <par type="DOUBLE" name="GFL_LTransformerHVPu" value="0.025"/>
    <!-- Measurement: tFilter = 1/OmegaLPF -->
    <par type="DOUBLE" name="GFL_KFilter" value="1"/>
    <par type="DOUBLE" name="GFL_tFilter" value="0.00333333333"/>
    <!-- Current loop: Kpc = (LFilter + LTransformerLV)*OmegaCC/omegaNom, Kic = (RFilter + RTransformerLV)*OmegaCC -->
    <par type="DOUBLE" name="GFL_Kpc" value="0.477464829"/>
    <par type="DOUBLE" name="GFL_Kic" value="4.8"/>
    <par type="DOUBLE" name="GFL_Kfd" value="1"/>
    <par type="DOUBLE" name="GFL_Kfq" value="0"/>
    <!-- Outer loop: Kp = OmegaOuter/OmegaLPF, Ki = OmegaOuter -->
    <par type="DOUBLE" name="GFL_KpdOuter" value="0.0333333333"/>
    <par type="DOUBLE" name="GFL_KidOuter" value="10"/>
    <par type="DOUBLE" name="GFL_KpqOuter" value="0.0333333333"/>
    <par type="DOUBLE" name="GFL_KiqOuter" value="10"/>
    <par type="DOUBLE" name="GFL_IMaxPu" value="10"/>
    <par type="BOOL" name="GFL_PQFlag" value="false"/>
    <par type="BOOL" name="GFL_PControlFlag" value="false"/>
    <par type="BOOL" name="GFL_QControlFlag" value="false"/>
    <par type="DOUBLE" name="GFL_UBoostHighPu" value="1.1"/>
    <par type="DOUBLE" name="GFL_UBoostLowPu" value="0.9"/>
    <par type="DOUBLE" name="GFL_Kqv" value="0"/>
    <par type="DOUBLE" name="GFL_IqBoostMaxPu" value="0.5"/>
    <par type="DOUBLE" name="GFL_IqBoostMinPu" value="-0.5"/>
    <par type="DOUBLE" name="GFL_tBoost" value="1e-4"/>
    <par type="DOUBLE" name="GFL_DidMax" value="10"/>
    <par type="DOUBLE" name="GFL_DidMin" value="-10"/>
    <par type="DOUBLE" name="GFL_tSid" value="1e-4"/>
    <par type="DOUBLE" name="GFL_tPlant" value="0.02"/>
    <!-- Plant controller: Kp = OmegaPlant/OmegaOuter, Ki = OmegaPlant -->
    <par type="DOUBLE" name="GFL_KppPlant" value="0.2"/>
    <par type="DOUBLE" name="GFL_KipPlant" value="2"/>
    <par type="DOUBLE" name="GFL_KpqPlant" value="0.2"/>
    <par type="DOUBLE" name="GFL_KiqPlant" value="2"/>
    <par type="DOUBLE" name="GFL_LambdaPu" value="0.417"/>
    <par type="DOUBLE" name="GFL_KDroop" value="15"/>
    <par type="DOUBLE" name="GFL_QMaxPu" value="0.3"/>
    <par type="DOUBLE" name="GFL_QMinPu" value="-0.3"/>
    <par type="DOUBLE" name="GFL_PMaxPu" value="2"/>
    <par type="DOUBLE" name="GFL_PMinPu" value="0"/>
    <par type="DOUBLE" name="GFL_FEMaxPu" value="999"/>
    <par type="DOUBLE" name="GFL_FEMinPu" value="-999"/>
    <par type="DOUBLE" name="GFL_FDbd1Pu" value="0.005"/>
    <par type="DOUBLE" name="GFL_FDbd2Pu" value="0.1"/>
    <par type="DOUBLE" name="GFL_DbdPu" value="0.0001"/>
    <!-- PLL: KpPLL = 2*KsiPLL*OmegaPLL/omegaNom, KiPLL = OmegaPLL^2/omegaNom -->
    <par type="DOUBLE" name="GFL_KpPLL" value="0.636619772"/>
    <par type="DOUBLE" name="GFL_KiPLL" value="31.8309886"/>
    <par type="DOUBLE" name="GFL_OmegaMaxPu" value="1.5"/>
    <par type="DOUBLE" name="GFL_OmegaMinPu" value="0.5"/>
  </set>

  <!-- Converter 2 (gFLmodel1): same as GFL1 except operating point, PMaxPu/PMinPu, DidMax/DidMin -->
  <set id="GFL2">
    <par type="DOUBLE" name="GFL_P0Pu" value="4.989324"/>
    <par type="DOUBLE" name="GFL_Q0Pu" value="-0.21"/>
    <par type="DOUBLE" name="GFL_U0Pu" value="1.086638"/>
    <par type="DOUBLE" name="GFL_UPhase0" value="-0.063421"/>
    <par type="DOUBLE" name="GFL_SNom" value="1000"/>
    <par type="DOUBLE" name="GFL_tVSC" value="1e-5"/>
    <par type="DOUBLE" name="GFL_RFilterPu" value="0.003"/>
    <par type="DOUBLE" name="GFL_LFilterPu" value="0.1"/>
    <par type="DOUBLE" name="GFL_CFilterPu" value="1e-5"/>
    <par type="DOUBLE" name="GFL_RTransformerLVPu" value="0.001"/>
    <par type="DOUBLE" name="GFL_LTransformerLVPu" value="0.025"/>
    <par type="DOUBLE" name="GFL_RTransformerHVPu" value="0.001"/>
    <par type="DOUBLE" name="GFL_LTransformerHVPu" value="0.025"/>
    <par type="DOUBLE" name="GFL_KFilter" value="1"/>
    <par type="DOUBLE" name="GFL_tFilter" value="0.00333333333"/>
    <par type="DOUBLE" name="GFL_Kpc" value="0.477464829"/>
    <par type="DOUBLE" name="GFL_Kic" value="4.8"/>
    <par type="DOUBLE" name="GFL_Kfd" value="1"/>
    <par type="DOUBLE" name="GFL_Kfq" value="0"/>
    <par type="DOUBLE" name="GFL_KpdOuter" value="0.0333333333"/>
    <par type="DOUBLE" name="GFL_KidOuter" value="10"/>
    <par type="DOUBLE" name="GFL_KpqOuter" value="0.0333333333"/>
    <par type="DOUBLE" name="GFL_KiqOuter" value="10"/>
    <par type="DOUBLE" name="GFL_IMaxPu" value="10"/>
    <par type="BOOL" name="GFL_PQFlag" value="false"/>
    <par type="BOOL" name="GFL_PControlFlag" value="false"/>
    <par type="BOOL" name="GFL_QControlFlag" value="false"/>
    <par type="DOUBLE" name="GFL_UBoostHighPu" value="1.1"/>
    <par type="DOUBLE" name="GFL_UBoostLowPu" value="0.9"/>
    <par type="DOUBLE" name="GFL_Kqv" value="0"/>
    <par type="DOUBLE" name="GFL_IqBoostMaxPu" value="0.5"/>
    <par type="DOUBLE" name="GFL_IqBoostMinPu" value="-0.5"/>
    <par type="DOUBLE" name="GFL_tBoost" value="1e-4"/>
    <par type="DOUBLE" name="GFL_DidMax" value="100000"/>
    <par type="DOUBLE" name="GFL_DidMin" value="-10000"/>
    <par type="DOUBLE" name="GFL_tSid" value="1e-4"/>
    <par type="DOUBLE" name="GFL_tPlant" value="0.02"/>
    <par type="DOUBLE" name="GFL_KppPlant" value="0.2"/>
    <par type="DOUBLE" name="GFL_KipPlant" value="2"/>
    <par type="DOUBLE" name="GFL_KpqPlant" value="0.2"/>
    <par type="DOUBLE" name="GFL_KiqPlant" value="2"/>
    <par type="DOUBLE" name="GFL_LambdaPu" value="0.417"/>
    <par type="DOUBLE" name="GFL_KDroop" value="15"/>
    <par type="DOUBLE" name="GFL_QMaxPu" value="0.3"/>
    <par type="DOUBLE" name="GFL_QMinPu" value="-0.3"/>
    <par type="DOUBLE" name="GFL_PMaxPu" value="0"/>
    <par type="DOUBLE" name="GFL_PMinPu" value="-2"/>
    <par type="DOUBLE" name="GFL_FEMaxPu" value="999"/>
    <par type="DOUBLE" name="GFL_FEMinPu" value="-999"/>
    <par type="DOUBLE" name="GFL_FDbd1Pu" value="0.005"/>
    <par type="DOUBLE" name="GFL_FDbd2Pu" value="0.1"/>
    <par type="DOUBLE" name="GFL_DbdPu" value="0.0001"/>
    <par type="DOUBLE" name="GFL_KpPLL" value="0.636619772"/>
    <par type="DOUBLE" name="GFL_KiPLL" value="31.8309886"/>
    <par type="DOUBLE" name="GFL_OmegaMaxPu" value="1.5"/>
    <par type="DOUBLE" name="GFL_OmegaMinPu" value="0.5"/>
  </set>

  <!-- Frequency reference -->
  <set id="OmegaRef">
    <par type="DOUBLE" name="setPoint_Value0" value="1"/>
  </set>
  <!-- PRef WP1: step from 0.5 pu to 0.6 pu at t = 50 s (offset as in OpenModelica) -->
  <set id="PRef1">
    <par type="DOUBLE" name="step_Value0" value="0.5"/>
    <par type="DOUBLE" name="step_Height" value="0.1"/>
    <par type="DOUBLE" name="step_tStep" value="50"/>
  </set>
  <!-- PRef WP2: step from -0.5 pu to -0.4 pu at t = 50 s (offset as in OpenModelica) -->
  <set id="PRef2">
    <par type="DOUBLE" name="step_Value0" value="-0.5"/>
    <par type="DOUBLE" name="step_Height" value="0.1"/>
    <par type="DOUBLE" name="step_tStep" value="50"/>
  </set>
  <!-- URef WP1: URef0Pu = U0Pu + LambdaPu*QPcc0Pu = 1.091230 + 0.417*0.021, step +10 % at t = 480 s -->
  <set id="URef1">
    <par type="DOUBLE" name="step_Value0" value="1.099987"/>
    <par type="DOUBLE" name="step_Height" value="0.1099987"/>
    <par type="DOUBLE" name="step_tStep" value="480"/>
  </set>
  <!-- URef WP2: URef0Pu = 1.086638 + 0.417*0.021 -->
  <set id="URef2">
    <par type="DOUBLE" name="setPoint_Value0" value="1.095395"/>
  </set>

  <!-- Line3 opened on side 1 at t = 51.5 s -->
  <set id="DisconnectLine3">
    <par type="DOUBLE" name="event_tEvent" value="51.5"/>
    <par type="BOOL" name="event_stateEvent1" value="true"/>
  </set>
</parametersSet>
