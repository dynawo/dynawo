  <curve model="Model" variable="TEST_beats"/>
  <curve model="Model" variable="TEST_less"/>
  <curve model="Model" variable="TEST_lessSwapped"/>
  <curve model="Model" variable="TEST_greater"/>
  <curve model="Model" variable="TEST_greaterSwapped"/>
  <curve model="Model" variable="TEST_lessEq"/>
  <curve model="Model" variable="TEST_lessEqSwapped"/>
  <curve model="Model" variable="TEST_greaterEq"/>
  <curve model="Model" variable="TEST_greaterEqSwapped"/>
</curvesInput>
